{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "studyforge",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "skills/studyforge/SKILL.md"
        },
        {
          "type": "generic",
          "path": "skills/studyforge/templates/repo/studyforge.toml"
        }
      ]
    }
  }
}
